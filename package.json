{
  "name": "papajohns-kiosk",
  "version": "1.2.7",
  "private": true,
  "description": "PapaJohn's customer web kiosk and Windows Electron shell",
  "author": "PapaJohn's Pangyo 2nd Techno Valley",
  "main": "desktop/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "desktop:dev": "electron . --dev",
    "desktop:build": "electron-builder",
    "desktop:build:win": "node -e \"if (process.platform !== 'win32') { console.error('Windows NSIS artifacts must be built on Windows to preserve uninstaller integrity.'); process.exit(1); }\" && npm run dist:win:x64",
    "dist:win:x64": "electron-builder --win --x64",
    "dist:win:ia32": "electron-builder --win --ia32",
    "dist:win:ia32:dir": "electron-builder --win --ia32 --dir",
    "dist:win:all": "electron-builder --win --x64 --ia32",
    "verify:win:ia32": "node scripts/verify-windows-pe.js ia32",
    "verify:win:x64": "node scripts/verify-windows-pe.js x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.6",
    "firebase": "10.12.5",
    "firebase-admin": "^14.2.0"
  },
  "build": {
    "appId": "kr.co.papajohns.kiosk",
    "productName": "PapaJohns Kiosk",
    "executableName": "PapaJohns-Kiosk",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "yunsh3181",
      "repo": "codex",
      "channel": "latest"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!release{,/**/*}",
      "!artifacts{,/**/*}",
      "!tests{,/**/*}",
      "!.git{,/**/*}",
      "!.github{,/**/*}",
      "!.DS_Store"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "PapaJohns-Kiosk-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "PapaJohns-Kiosk-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
